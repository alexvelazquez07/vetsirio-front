# Variables del build de producción. No llevar secretos: todo lo VITE_* queda
# dentro del bundle y es visible en las herramientas del navegador.
#
# El front se sirve en https://signiasoft.com/vetsirio/ y la API en el mismo
# origen, bajo /vetsirio/api. Al ser una URL relativa, las cookies de sesión
# viajan sin CORS y el bundle no depende del dominio: si un día se mueve a
# vetsirio.com, sólo se cambia este archivo.
VITE_API_URL=/vetsirio/api/v1

VITE_APP_NAME=VetSirio
