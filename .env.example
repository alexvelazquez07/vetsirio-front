# Variables de entorno del frontend.
#
# Se expone sólo lo que lleva el prefijo VITE_: todo lo que se escriba acá
# viaja dentro del bundle y es visible para cualquiera que abra las
# herramientas de desarrollo. Nunca pongas un secreto acá.

# URL base de la API.
#
# En desarrollo se deja vacío a propósito: vite.config.ts hace proxy de /api
# hacia localhost:3000. Gracias a eso el frontend y el backend comparten
# origen, las cookies de sesión funcionan sin CORS y el código es idéntico al
# de producción detrás de Nginx.
VITE_API_URL=/api/v1

# En producción conviene poner la URL absoluta, por ejemplo:
# VITE_API_URL=https://api.vetsirio.com/api/v1

# Nombre del producto, para mostrar en títulos y metadatos.
VITE_APP_NAME=VetSirio